# ─── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://icc_app:CHANGE_ME@localhost:5432/icc_thinkific
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icc_thinkific
DB_USER=icc_app
DB_PASS=CHANGE_ME

# ─── Auth / Cookies ───────────────────────────────────────
# Generate: openssl rand -hex 32
COOKIE_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
SESSION_SECRET=CHANGE_ME_32_BYTES_HEX
COOKIE_DOMAIN=

# ─── CORS (comma-separated extra allowed origins) ─────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://your-domain.com

# ─── Thinkific OAuth ──────────────────────────────────────
THINKIFIC_SUBDOMAIN=your-subdomain
THINKIFIC_API_KEY=
THINKIFIC_CLIENT_ID=
THINKIFIC_CLIENT_SECRET=
THINKIFIC_OAUTH_REDIRECT_URI=http://your-domain.com/api/v1/auth/thinkific/callback

# ─── Elvanto API ──────────────────────────────────────────
ELVANTO_API_KEY=
ELVANTO_DOMAIN=

# ─── Zoom Server-to-Server OAuth ──────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ─── SMTP (mailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PCNC Corporate <no-reply@your-domain.com>"

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
