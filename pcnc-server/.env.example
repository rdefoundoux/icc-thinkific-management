# ─────────────────────────────────────────────────────────────
#  pcnc-server — environment template (copy to .env)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── PostgreSQL (replaces MongoDB) ───────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://pcnc:pcnc@localhost:5432/pcnc?schema=public

# ── Auth secrets (min 32 chars each) ────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
COOKIE_SECRET=replace-me-with-another-long-random-string-32-chars+
COOKIE_DOMAIN=

# ── Frontend / CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# ── Thinkific ───────────────────────────────────────────────
THINKIFIC_CLIENT_ID=
THINKIFIC_CLIENT_SECRET=
THINKIFIC_SUBDOMAIN=
THINKIFIC_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/thinkific/callback

# ── Elvanto ─────────────────────────────────────────────────
ELVANTO_CLIENT_ID=
ELVANTO_CLIENT_SECRET=
ELVANTO_REDIRECT_URI=http://localhost:3000/api/v1/elvanto/callback

# ── Zoom (optional) ─────────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Email / SMTP (optional) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
